---
// Jeu d'icônes dessiné à la main, inliné, plutôt qu'une librairie :
// aucune dépendance n'est ajoutée sans décision (CLAUDE.md), et les
// librairies courantes (Lucide, Feather) sont précisément la signature
// visuelle générique que les références du projet évitent.
//
// Contraintes tenues par tous les tracés : grille 24, trait unique de
// 1.25, `currentColor`, aucun remplissage — même graisse que le tracé au
// trait du logo, dont ils doivent avoir l'air de la même famille.
// Métaphores volontairement abstraites : ni fusée pour « lancement », ni
// bouclier pour « fiabilité ».

import type { IconName } from "../lib/icons";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string[]> = {
	// Sites et médias : un cadre et sa ligne de titre — l'objet livré.
	frame: ["M3 5.5h18v13H3z", "M3 9.5h18", "M6 7h0.01"],
	// Formation IA : une étincelle à quatre branches concaves. La méthode
	// est banale pour « IA » — assumé : la cible a une faible culture
	// digitale, un signe qu'elle reconnaît vaut mieux qu'un signe
	// original qu'elle doit décoder. Une petite seconde étincelle décale
	// la symétrie, sinon le tracé se lit comme un simple losange.
	spark: [
		"M12 3.5c0 4.7 1.8 6.5 6.5 6.5-4.7 0-6.5 1.8-6.5 6.5 0-4.7-1.8-6.5-6.5-6.5 4.7 0 6.5-1.8 6.5-6.5z",
		"M17.5 15.5c0 2.2.8 3 3 3-2.2 0-3 .8-3 3 0-2.2-.8-3-3-3 2.2 0 3-.8 3-3z",
	],
	// Contenu : un cadre d'image et un triangle de lecture — visuels et
	// vidéos en un seul signe. Même famille que `frame` (le cadre), le
	// triangle dit la vidéo sans pictogramme « caméra » daté.
	media: ["M3 5.5h18v13H3z", "M10 9.5v5l4.5-2.5z"],
	// Proximité : deux disques qui se recouvrent, un seul interlocuteur.
	dialogue: ["M9.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0z", "M5.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0z"],
	// Réactivité : un signal qui repart net, sans le cliché de l'éclair.
	pulse: ["M3 14h3.5l2-6 3 11 2.5-7 1.5 2H21"],
	// Transparence : un prisme, ce qui entre ressort lisible.
	prism: ["M12 4l7.5 13H4.5z", "M12 4v13", "M8.2 17l3.8-6.5 3.8 6.5"],
	// Transparence : une étiquette de prix, percée de son œillet. Plus
	// littérale que le prisme qu'elle remplace (2026-08-11) : la valeur
	// parle de prix annoncés, et une cible peu à l'aise avec le digital
	// reconnaît une étiquette sans avoir à interpréter une métaphore
	// optique.
	tag: ["M12.5 3.5H20.5V11.5L11 21 3 13z", "M17 7h0.01"],
	// Rigueur bout-en-bout : un fil continu, jamais rompu ni relayé.
	thread: ["M4 17c4 0 4-10 8-10s4 10 8 10", "M4 17h0.01", "M20 17h0.01"],
};
---

<svg
	class:list={["shrink-0", className]}
	viewBox="0 0 24 24"
	width="24"
	height="24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.25"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{paths[name].map((d) => <path d={d} />)}
</svg>
